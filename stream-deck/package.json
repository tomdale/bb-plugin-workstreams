{
  "name": "bb-workstreams-stream-deck",
  "version": "1.0.0",
  "private": true,
  "description": "Stream Deck plugin that shows Workstreams' Up Next and opens its threads in BB.",
  "type": "module",
  "engines": {
    "node": ">=20.5.1"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "streamdeck validate com.tomdale.bb-workstreams.sdPlugin",
    "link": "streamdeck link com.tomdale.bb-workstreams.sdPlugin",
    "restart": "streamdeck restart com.tomdale.bb-workstreams",
    "pack": "streamdeck pack com.tomdale.bb-workstreams.sdPlugin --output dist --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.4",
    "@types/node": "~24.19.2",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
