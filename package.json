{
  "name": "bb-plugin-workstreams",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.6.5"
  },
  "bb": {
    "name": "Workstreams",
    "description": "Organize open BB threads in one reviewed pass, then route new work into stable homes.",
    "branding": {
      "icon": "./assets/workstream.svg",
      "experimental_icons": {
        "workstream": "./assets/workstream.svg",
        "tag": "./assets/tag.svg"
      }
    },
    "server": "./src/server/index.ts",
    "app": "./src/app/index.tsx",
    "host": "./src/server/inference/host.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@get-bb/plugin-sdk": "0.6.5",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.7.0",
    "unified": "^11.0.5",
    "vite": "^8.3.6",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "bb plugin build",
    "gallery": "vite --config gallery/vite.config.ts",
    "gallery:build": "GALLERY_PAGE=gallery vite build --config gallery/vite.config.ts && GALLERY_PAGE=sidebar vite build --config gallery/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:benchmark": "node scripts/benchmark-tests.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "files": [
    "assets",
    "dist",
    "src",
    "components",
    "lib",
    "hooks",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "tsconfig.json"
  ]
}
